{
  "name": "kuvth-zebrafish-lims-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "lint": "biome ci src tests",
    "format": "biome check src tests --write",
    "build": "tsc --noEmit && vite build",
    "check": "npm run lint && npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.6",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.11"
  }
}
