# Backend
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
IP_ALLOWLIST=
DB_DRIVER=memory
DATABASE_URL=
APP_ENV=development
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# Set the first admin address explicitly. Production requires all three values below.
# AUTH_SECRET must contain at least 32 characters outside development and test.
BOOTSTRAP_ADMIN_EMAIL=
AUTH_SECRET=
SESSION_COOKIE_SECURE=false
APP_BASE_URL=http://localhost:5173

# SMTP is required for invitations and verified password setup/reset. Use credentials authorized by the provider.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SENDER_EMAIL=
MAIL_USE_SSL=false
# Disable only for a local SMTP catcher in development/test.
MAIL_USE_STARTTLS=true
# Optional, only when using compose.smtp-ca.yaml or compose.mysql.smtp-ca.yaml.
# Host path to an approved antivirus/proxy root CA in PEM format; never a private key.
# SMTP_CA_FILE=C:/path/to/approved-smtp-root.pem

# Frontend build-time setting. Keep /api/v1 when the frontend and API share a host.
VITE_API_BASE_URL=/api/v1
FRONTEND_PORT=5173
API_PORT=8082
