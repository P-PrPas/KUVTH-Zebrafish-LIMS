# Backend
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
IP_ALLOWLIST=
DB_DRIVER=memory
DATABASE_URL=
APP_ENV=development
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# Authentication bootstrap and persistent cookie sessions
BOOTSTRAP_ADMIN_EMAIL=peerapas.c@ku.th
AUTH_SECRET=replace-with-a-long-random-secret-before-production
SESSION_COOKIE_SECURE=false
APP_BASE_URL=http://localhost:5173

# SMTP is required for OTP and invitation email. Use credentials authorized by KU IT.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SENDER_EMAIL=peerapas.c@ku.th
MAIL_USE_SSL=false

# Frontend build-time setting. Keep /api/v1 when the frontend and API share a host.
VITE_API_BASE_URL=/api/v1
FRONTEND_PORT=5173
API_PORT=8082
