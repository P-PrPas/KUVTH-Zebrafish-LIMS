    audit_log [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#868E96" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="12"><B>audit_log</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF2FF" PORT="id"><B>id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT COLOR="#495057" POINT-SIZE="9"><B>PK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="table_name">table_name</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">varchar(64)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="record_id">record_id</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="action">action</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">varchar(10)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#868E96" POINT-SIZE="9">INSERT | UPDATE | DELETE</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF9DB" PORT="operator_id">operator_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT COLOR="#495057" POINT-SIZE="9"><B>FK</B></FONT> <FONT COLOR="#868E96" POINT-SIZE="9">nullable</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="occurred_at">occurred_at</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">timestamp</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#868E96" POINT-SIZE="9">UTC</FONT></TD></TR></TABLE>>];
    request_idempotency [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#868E96" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="12"><B>request_idempotency</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF2FF" PORT="scope"><B>scope</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT POINT-SIZE="9">varchar(180)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT COLOR="#495057" POINT-SIZE="9"><B>PK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF2FF" PORT="idempotency_key"><B>idempotency_key</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT COLOR="#495057" POINT-SIZE="9"><B>PK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="request_hash">request_hash</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">char(64)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="status_code">status_code</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">int</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF9DB" PORT="operator_id">operator_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT COLOR="#495057" POINT-SIZE="9"><B>FK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="lease_until">lease_until</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">timestamp</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#868E96" POINT-SIZE="9">single-flight lease (000004)</FONT></TD></TR></TABLE>>];
    fish_running_sequence [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#868E96" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="12"><B>fish_running_sequence</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF2FF" PORT="id"><B>id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT COLOR="#495057" POINT-SIZE="9"><B>PK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="next_running_no">next_running_no</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">int</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#868E96" POINT-SIZE="9">allocated under row lock (000006)</FONT></TD></TR></TABLE>>];
  }

  site:id:e -> operator:site_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#adb5bd"];
  site:id:e -> fish_box:site_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#adb5bd"];
  protocol:id:e -> stage_definition:protocol_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#adb5bd"];
  protocol:id:e -> stage_timing_profile:protocol_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#adb5bd"];
  stage_timing_profile:id:e -> stage_timing:profile_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#adb5bd"];
  stage_definition:id:e -> stage_timing:stage_definition_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#adb5bd"];
  site:id:e -> experiment_batch:site_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#adb5bd"];
  protocol:id:e -> experiment_batch:protocol_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#adb5bd"];
  stage_timing_profile:id:e -> experiment_batch:timing_profile_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#adb5bd"];
  treatment_group:id:e -> experiment_batch:treatment_group_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#adb5bd"];
  recipient_egg_lot:id:e -> experiment_batch:recipient_egg_lot_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#adb5bd"];
  csof_lot:id:e -> experiment_batch:csof_lot_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#adb5bd"];
  experiment_batch:id:e -> injection_lot:batch_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#adb5bd"];
  donor_cell_line:id:e -> injection_lot:donor_cell_line_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#adb5bd"];
  injection_lot:id:e -> embryo:injection_lot_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#adb5bd"];
  stage_definition:id:e -> embryo:exit_stage_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#dee2e6"];
  embryo:id:e -> embryo_observation:embryo_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#adb5bd"];
  stage_definition:id:e -> embryo_observation:stage_definition_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#dee2e6"];
  embryo_observation:id:e -> embryo:first_abnormal_observation_id:w [dir=both, arrowtail=teetee, arrowhead=crowodot, style=dashed, color="#f06595", constraint=false];
  experiment_batch:id:e -> control_arm_count:batch_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#adb5bd"];
  stage_definition:id:e -> control_arm_count:stage_definition_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#dee2e6"];
  embryo:id:e -> clone_fish:embryo_id:w [dir=both, arrowtail=teetee, arrowhead=teetee, style=solid, color="#adb5bd"];
  donor_cell_line:id:e -> clone_fish:donor_cell_line_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#adb5bd"];
  site:id:e -> clone_fish:site_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#adb5bd"];
  fish_box:id:e -> clone_fish:fish_box_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#adb5bd"];
  stage_definition:id:e -> clone_fish:first_abnormal_stage_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#dee2e6"];
  clone_fish:id:e -> fish_observation:clone_fish_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#adb5bd"];
  clone_fish:id:e -> specimen:clone_fish_id:w [dir=both, arrowtail=teetee, arrowhead=crow, style=solid, color="#adb5bd"];

  legend [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#F8F9FA">
      <TR><TD ALIGN="LEFT"><B>Notation</B></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">crow&#8217;s foot = &#8220;many&#8221; end &#183; bar = &#8220;exactly one&#8221; &#183; dashed pink = deferred / circular FK</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">grey rows = PK &#183; yellow rows = FK &#183; light-grey lines = reference to the stage hub</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9"><B>operator</B>.id &#8592; operator_id on: stage_timing_profile, experiment_batch, embryo_observation, fish_observation, audit_log, request_idempotency (edges omitted for clarity)</FONT></TD></TR>
    </TABLE>>];
  { rank=sink; legend; }
}
