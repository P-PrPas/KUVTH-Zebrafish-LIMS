digraph zebrafish_lims {
  graph [rankdir=LR, splines=ortho, nodesep=0.6, ranksep=2.2, pad=0.5,
         mclimit=4, fontname="Helvetica", fontsize=11, bgcolor="white"];
  node  [shape=plain, fontname="Helvetica", fontsize=10];
  edge  [color="#adb5bd", penwidth=1.2, arrowsize=0.9];

  label=<<B>KUVTH Zebrafish LIMS &mdash; Database schema</B>  (backend/db/migrations/postgres 000001&ndash;000009)>;
  labelloc=t;  fontsize=16;

  subgraph cluster_master {
    label=<<FONT COLOR="#4C6EF5"><B>Master / reference data</B></FONT>>;
    style="rounded";  color="#4C6EF5";  penwidth=1.6;  margin=26;
    site [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#4C6EF5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="12"><B>site</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF2FF" PORT="id"><B>id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT COLOR="#495057" POINT-SIZE="9"><B>PK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F3F5" PORT="code">code</TD><TD ALIGN="LEFT" BGCOLOR="#F1F3F5"><FONT POINT-SIZE="9">varchar(20)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F1F3F5"><FONT COLOR="#495057" POINT-SIZE="9"><B>UK</B></FONT> <FONT COLOR="#868E96" POINT-SIZE="9">normalised</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="name">name</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">varchar(200)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="active">active</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">bool</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"></TD></TR></TABLE>>];
    operator [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#4C6EF5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="12"><B>operator</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF2FF" PORT="id"><B>id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT COLOR="#495057" POINT-SIZE="9"><B>PK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF9DB" PORT="site_id">site_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT COLOR="#495057" POINT-SIZE="9"><B>FK</B></FONT> <FONT COLOR="#868E96" POINT-SIZE="9">nullable</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F3F5" PORT="name">name</TD><TD ALIGN="LEFT" BGCOLOR="#F1F3F5"><FONT POINT-SIZE="9">varchar(100)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F1F3F5"><FONT COLOR="#495057" POINT-SIZE="9"><B>UK</B></FONT> <FONT COLOR="#868E96" POINT-SIZE="9">normalised</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="active">active</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">bool</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"></TD></TR></TABLE>>];
    donor_cell_line [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#4C6EF5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="12"><B>donor_cell_line</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF2FF" PORT="id"><B>id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT COLOR="#495057" POINT-SIZE="9"><B>PK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="strain">strain</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">varchar(50)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#868E96" POINT-SIZE="9">AB / TU / NHGRI</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="preparation">preparation</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">varchar(50)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#868E96" POINT-SIZE="9">DISSOCIATED | CHUNKS</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="batch_code">batch_code</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">varchar(100)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#868E96" POINT-SIZE="9">nullable</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="active">active</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">bool</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#868E96" POINT-SIZE="9">uq(strain,preparation,batch_code)</FONT></TD></TR></TABLE>>];
    recipient_egg_lot [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#4C6EF5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="12"><B>recipient_egg_lot</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF2FF" PORT="id"><B>id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT COLOR="#495057" POINT-SIZE="9"><B>PK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="breed">breed</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">varchar(100)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F3F5" PORT="label">label</TD><TD ALIGN="LEFT" BGCOLOR="#F1F3F5"><FONT POINT-SIZE="9">varchar(200)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F1F3F5"><FONT COLOR="#495057" POINT-SIZE="9"><B>UK</B></FONT> <FONT COLOR="#868E96" POINT-SIZE="9">normalised</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="lot_date">lot_date</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">date</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#868E96" POINT-SIZE="9">nullable</FONT></TD></TR></TABLE>>];
    csof_lot [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#4C6EF5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="12"><B>csof_lot</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF2FF" PORT="id"><B>id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT COLOR="#495057" POINT-SIZE="9"><B>PK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F3F5" PORT="lot_code">lot_code</TD><TD ALIGN="LEFT" BGCOLOR="#F1F3F5"><FONT POINT-SIZE="9">varchar(100)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F1F3F5"><FONT COLOR="#495057" POINT-SIZE="9"><B>UK</B></FONT> <FONT COLOR="#868E96" POINT-SIZE="9">normalised</FONT></TD></TR></TABLE>>];
    treatment_group [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#4C6EF5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="12"><B>treatment_group</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF2FF" PORT="id"><B>id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT COLOR="#495057" POINT-SIZE="9"><B>PK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F3F5" PORT="code">code</TD><TD ALIGN="LEFT" BGCOLOR="#F1F3F5"><FONT POINT-SIZE="9">varchar(50)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F1F3F5"><FONT COLOR="#495057" POINT-SIZE="9"><B>UK</B></FONT> <FONT COLOR="#868E96" POINT-SIZE="9">normalised</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="arm_type">arm_type</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">varchar(20)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#868E96" POINT-SIZE="9">SCNT | NATURAL_BREEDING | IVF</FONT></TD></TR></TABLE>>];
    fish_box [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#4C6EF5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="12"><B>fish_box</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF2FF" PORT="id"><B>id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT COLOR="#495057" POINT-SIZE="9"><B>PK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF9DB" PORT="site_id">site_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT COLOR="#495057" POINT-SIZE="9"><B>FK</B></FONT> <FONT COLOR="#868E96" POINT-SIZE="9">nullable</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="box_code">box_code</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">varchar(50)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#868E96" POINT-SIZE="9">uq(site_id, box_code)</FONT></TD></TR></TABLE>>];
  }

  subgraph cluster_protocol {
    label=<<FONT COLOR="#7048E8"><B>Protocol &amp; reference timing</B></FONT>>;
    style="rounded";  color="#7048E8";  penwidth=1.6;  margin=26;
    protocol [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#7048E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="12"><B>protocol</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF2FF" PORT="id"><B>id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT COLOR="#495057" POINT-SIZE="9"><B>PK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="name">name</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">varchar(200)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="stage1_max_age_days">stage1_max_age_days</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">int</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#868E96" POINT-SIZE="9">default 5 (BR-09)</FONT></TD></TR></TABLE>>];
    stage_definition [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#7048E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="12"><B>stage_definition</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF2FF" PORT="id"><B>id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT COLOR="#495057" POINT-SIZE="9"><B>PK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF9DB" PORT="protocol_id">protocol_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT COLOR="#495057" POINT-SIZE="9"><B>FK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="stage_order">stage_order</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">int</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#868E96" POINT-SIZE="9">1..36, uq per protocol</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F3F5" PORT="code">code</TD><TD ALIGN="LEFT" BGCOLOR="#F1F3F5"><FONT POINT-SIZE="9">varchar(50)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F1F3F5"><FONT COLOR="#495057" POINT-SIZE="9"><B>UK</B></FONT> <FONT COLOR="#868E96" POINT-SIZE="9">per protocol</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="short_label">short_label</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">varchar(20)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#868E96" POINT-SIZE="9">e.g. 2C</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="phase">phase</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">varchar(20)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#868E96" POINT-SIZE="9">CLEAVAGE|BLASTULA|GASTRULA|LARVAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="stage_scope">stage_scope</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">varchar(10)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#868E96" POINT-SIZE="9">STAGE_1 | STAGE_2</FONT></TD></TR></TABLE>>];
    stage_timing_profile [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#7048E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="12"><B>stage_timing_profile</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF2FF" PORT="id"><B>id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT COLOR="#495057" POINT-SIZE="9"><B>PK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF9DB" PORT="protocol_id">protocol_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT COLOR="#495057" POINT-SIZE="9"><B>FK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="version">version</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">int</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#868E96" POINT-SIZE="9">uq per protocol</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="name">name</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">varchar(200)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="reference_temp_c">reference_temp_c</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">decimal(4,1)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#868E96" POINT-SIZE="9">default 28.5</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="is_current">is_current</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">bool</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#868E96" POINT-SIZE="9">&lt;=1 live row per protocol</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF9DB" PORT="created_by_operator_id">created_by_operator_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT COLOR="#495057" POINT-SIZE="9"><B>FK</B></FONT> <FONT COLOR="#868E96" POINT-SIZE="9">nullable</FONT></TD></TR></TABLE>>];
    stage_timing [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#7048E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="12"><B>stage_timing</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF2FF" PORT="id"><B>id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT COLOR="#495057" POINT-SIZE="9"><B>PK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF9DB" PORT="protocol_id">protocol_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT COLOR="#495057" POINT-SIZE="9"><B>FK</B></FONT> <FONT COLOR="#868E96" POINT-SIZE="9">composite guard</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF9DB" PORT="profile_id">profile_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT COLOR="#495057" POINT-SIZE="9"><B>FK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF9DB" PORT="stage_definition_id">stage_definition_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT COLOR="#495057" POINT-SIZE="9"><B>FK</B></FONT> <FONT COLOR="#868E96" POINT-SIZE="9">uq(profile_id, stage_definition_id)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="expected_hpa">expected_hpa</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">decimal(10,4)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#868E96" POINT-SIZE="9">hours post-activation, &gt;= 0</FONT></TD></TR></TABLE>>];
  }

  subgraph cluster_experiment {
    label=<<FONT COLOR="#0CA678"><B>Experiment structure</B></FONT>>;
    style="rounded";  color="#0CA678";  penwidth=1.6;  margin=26;
    experiment_batch [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#0CA678" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="12"><B>experiment_batch</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF2FF" PORT="id"><B>id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT COLOR="#495057" POINT-SIZE="9"><B>PK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F1F3F5" PORT="batch_code">batch_code</TD><TD ALIGN="LEFT" BGCOLOR="#F1F3F5"><FONT POINT-SIZE="9">varchar(100)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#F1F3F5"><FONT COLOR="#495057" POINT-SIZE="9"><B>UK</B></FONT> <FONT COLOR="#868E96" POINT-SIZE="9">normalised</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="experiment_date">experiment_date</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">date</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF9DB" PORT="site_id">site_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT COLOR="#495057" POINT-SIZE="9"><B>FK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF9DB" PORT="operator_id">operator_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT COLOR="#495057" POINT-SIZE="9"><B>FK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF9DB" PORT="protocol_id">protocol_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT COLOR="#495057" POINT-SIZE="9"><B>FK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF9DB" PORT="timing_profile_id">timing_profile_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT COLOR="#495057" POINT-SIZE="9"><B>FK</B></FONT> <FONT COLOR="#868E96" POINT-SIZE="9">pinned at creation (FR-303)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF9DB" PORT="treatment_group_id">treatment_group_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT COLOR="#495057" POINT-SIZE="9"><B>FK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF9DB" PORT="recipient_egg_lot_id">recipient_egg_lot_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT COLOR="#495057" POINT-SIZE="9"><B>FK</B></FONT> <FONT COLOR="#868E96" POINT-SIZE="9">nullable</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF9DB" PORT="csof_lot_id">csof_lot_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT COLOR="#495057" POINT-SIZE="9"><B>FK</B></FONT> <FONT COLOR="#868E96" POINT-SIZE="9">nullable</FONT></TD></TR></TABLE>>];
    injection_lot [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#0CA678" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="12"><B>injection_lot</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF2FF" PORT="id"><B>id</B></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF2FF"><FONT COLOR="#495057" POINT-SIZE="9"><B>PK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF9DB" PORT="batch_id">batch_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT COLOR="#495057" POINT-SIZE="9"><B>FK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="lot_no">lot_no</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">varchar(20)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#868E96" POINT-SIZE="9">text, uq per batch</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF9DB" PORT="donor_cell_line_id">donor_cell_line_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT POINT-SIZE="9">char(36)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FFF9DB"><FONT COLOR="#495057" POINT-SIZE="9"><B>FK</B></FONT> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="activated_at">activated_at</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">timestamp</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#868E96" POINT-SIZE="9">T0 of the system (BR-01); nullable draft</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="n_activated">n_activated</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">int</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#868E96" POINT-SIZE="9">= embryos produced</FONT></TD></TR></TABLE>>];
