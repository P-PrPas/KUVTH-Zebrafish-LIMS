# Copy to /root/app/vetku/.env and chmod 600. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
AUTH_SECRET=

APP_ENV=production
APP_BASE_URL=https://kuvacb-aqlims.vet.ku.ac.th
CORS_ALLOWED_ORIGINS=https://kuvacb-aqlims.vet.ku.ac.th
# Keep true in production; login cookies then only work once the site is served over HTTPS.
SESSION_COOKIE_SECURE=true
IP_ALLOWLIST=

BOOTSTRAP_ADMIN_EMAIL=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SENDER_EMAIL=
MAIL_USE_SSL=false
MAIL_USE_STARTTLS=true
